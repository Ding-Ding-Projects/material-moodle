[Unit]
Description=Material Moodle status screen on the console
After=material-firstboot.service material-moodle.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/local/sbin/material-console
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
