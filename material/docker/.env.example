# Copy to .env and fill in. The deployer app writes this file for you.
MOODLE_SITE_NAME=Material Moodle
MOODLE_SITE_SHORTNAME=Moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=change-me-Now-1!
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_DB_PASSWORD=change-me-too
# Public address. Use "auto" with a quick tunnel; it follows the address visitors use, limited to MOODLE_TRUSTED_HOSTS.
MOODLE_WWWROOT=http://localhost:8080
MOODLE_TRUSTED_HOSTS=localhost,localhost:*,*.trycloudflare.com
MOODLE_PORT=8080
# Material theme defaults applied on first start (all editable later under Site administration).
MATERIAL_SEED_COLOR=#8B5000
MATERIAL_ENABLE_PASSKEYS=1
# Named tunnel token from the Cloudflare dashboard or the deployer's guided sign-in.
CLOUDFLARE_TUNNEL_TOKEN=
