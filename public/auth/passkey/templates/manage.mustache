{{!
    @template auth_passkey/manage

    The passkey manager.

    Example context (json):
    {
        "enabled": true,
        "haskeys": true,
        "own": true, "multiple": false, "bulkurl": "#", "sesskey": "x",
        "items": [{"id": 1, "name": "Laptop", "created": "3 Sep 2026", "lastused": "Today", "renameurl": "#", "deleteurl": "#", "sesskey": "x"}]
    }
}}
<div class="auth-passkey-manage" data-region="auth-passkey-manage">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        {{#own}}<p class="lead mb-0" style="max-width: 46rem;">{{#str}}managepasskeys_desc, auth_passkey{{/str}}</p>{{/own}}
        {{^own}}<p class="lead mb-0" style="max-width: 46rem;">{{#str}}managepasskeysother_desc, auth_passkey{{/str}}</p>{{/own}}
        {{#own}}
        <div class="d-flex flex-column gap-2 align-items-stretch">
            <label class="visually-hidden" for="auth-passkey-name">{{#str}}passkeyname, auth_passkey{{/str}}</label>
            <input type="text" id="auth-passkey-name" class="form-control" maxlength="255" placeholder="{{#str}}passkeyname_placeholder, auth_passkey{{/str}}">
            <button type="button" class="btn btn-secondary btn-lg" data-action="auth-passkey-add">{{#str}}addpasskey, auth_passkey{{/str}}</button>
        </div>
        {{/own}}
    </div>
    {{^enabled}}
        <div class="alert alert-warning">{{#str}}notenabled, auth_passkey{{/str}}</div>
    {{/enabled}}
    <div data-region="auth-passkey-status" aria-live="polite"></div>
    {{#haskeys}}
    {{#multiple}}
    <form method="post" action="{{bulkurl}}" id="auth-passkey-bulk" class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="deleteselected">
        <label class="d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input m-0" data-action="auth-passkey-selectall"> {{#str}}selectall{{/str}}</label>
        <button type="submit" class="btn btn-outline-danger">{{#str}}removeselected, auth_passkey{{/str}}</button>
    </form>
    {{/multiple}}
    <ul class="list-unstyled d-flex flex-column gap-3">
        {{#items}}
        <li class="card">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                {{#multiple}}<input type="checkbox" class="form-check-input m-0" name="ids[]" value="{{id}}" form="auth-passkey-bulk" aria-label="{{#str}}selectpasskey, auth_passkey, {{name}}{{/str}}">{{/multiple}}
                <span class="auth-passkey-icon" aria-hidden="true">{{#pix}}i/passkey, auth_passkey{{/pix}}</span>
                <div class="flex-grow-1" style="min-width: 14rem;">
                    <h2 class="h5 mb-1">{{name}}</h2>
                    <p class="mb-0 text-muted small">{{#str}}addedon, auth_passkey, {{created}}{{/str}} · {{#str}}lastused, auth_passkey, {{lastused}}{{/str}}</p>
                </div>
                <form method="post" action="{{renameurl}}" class="d-flex gap-2 align-items-center">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="rename">
                    <input type="hidden" name="id" value="{{id}}">
                    <label class="visually-hidden" for="auth-passkey-rename-{{id}}">{{#str}}rename, auth_passkey{{/str}}</label>
                    <input type="text" class="form-control" id="auth-passkey-rename-{{id}}" name="name" value="{{name}}" maxlength="255">
                    <button type="submit" class="btn btn-outline-secondary">{{#str}}rename, auth_passkey{{/str}}</button>
                </form>
                <a class="btn btn-danger" href="{{deleteurl}}">{{#str}}remove, auth_passkey{{/str}}</a>
            </div>
        </li>
        {{/items}}
    </ul>
    {{/haskeys}}
    {{^haskeys}}
        <div class="card"><div class="card-body text-center py-5">
            <p class="h5">{{#str}}nopasskeys, auth_passkey{{/str}}</p>
            <p class="text-muted mb-0">{{#str}}nopasskeys_desc, auth_passkey{{/str}}</p>
        </div></div>
    {{/haskeys}}
</div>
{{#js}}
document.querySelectorAll('[data-action="auth-passkey-selectall"]').forEach(function(all) {
    all.addEventListener('change', function() {
        document.querySelectorAll('input[name="ids[]"][form="auth-passkey-bulk"]').forEach(function(box) {
            box.checked = all.checked;
        });
    });
});
{{/js}}
