<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/bathroompass/db" VERSION="20261123" COMMENT="XMLDB file for Moodle local/bathroompass"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_bpass_settings" COMMENT="Bathroom pass settings for one course">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="passes" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="5" SEQUENCE="false" COMMENT="Passes per period; -1 means unlimited"/>
        <FIELD NAME="period" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="quarter" SEQUENCE="false" COMMENT="week, month, quarter, halfyear or course"/>
        <FIELD NAME="goldenstep" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="5" SEQUENCE="false" COMMENT="Percent of heads chance turned golden per extra break"/>
        <FIELD NAME="webhookout" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="URL called when a student leaves"/>
        <FIELD NAME="webhookin" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="URL called when a student is back"/>
        <FIELD NAME="includename" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Whether webhooks carry the student's first name"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign-unique" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_bpass_breaks" COMMENT="Every bathroom break a student took">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeout" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When the student left"/>
        <FIELD NAME="timein" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When the student came back; 0 while out"/>
        <FIELD NAME="overallowance" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Whether this break started beyond the allowance"/>
        <FIELD NAME="endedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 when the student ended it, else the teacher's user id"/>
        <FIELD NAME="outstatus" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="HTTP status of the leave webhook; 0 if not sent or failed"/>
        <FIELD NAME="instatus" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="HTTP status of the back webhook; 0 if not sent or failed"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseuser" UNIQUE="false" FIELDS="courseid, userid, timeout"/>
        <INDEX NAME="courseopen" UNIQUE="false" FIELDS="courseid, timein"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
