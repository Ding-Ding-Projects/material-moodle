{{!
    @template local_groupchats/access

    Messaging access checks and the one-click fix.

    Example context (json):
    {
        "checks": [{"label": "Messaging", "ok": true, "value": "On", "help": "Text", "code": ""}],
        "allok": true, "done": false, "sesskey": "x", "actionurl": "#", "permissionsurl": "#"
    }
}}
<div class="local-groupchats local-groupchats-access">
    {{#done}}<div class="alert alert-success local-groupchats-pop" role="status" data-md-celebrate="success">{{#str}}done_allowed, local_groupchats{{/str}}</div>{{/done}}
    <p class="lead">{{#str}}access_intro, local_groupchats{{/str}}</p>
    <ul class="list-group mb-4">
        {{#checks}}
        <li class="list-group-item d-flex gap-3 align-items-start local-groupchats-check {{#ok}}is-ok{{/ok}}{{^ok}}is-bad{{/ok}}">
            <span class="local-groupchats-status" aria-hidden="true">{{#ok}}✓{{/ok}}{{^ok}}!{{/ok}}</span>
            <div class="flex-grow-1">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <strong>{{label}}</strong>
                    <span class="local-groupchats-chip {{#ok}}is-ok{{/ok}}{{^ok}}is-bad{{/ok}}">{{value}}<span class="visually-hidden"> {{#ok}}{{#str}}ok, local_groupchats{{/str}}{{/ok}}{{^ok}}{{#str}}needsattention, local_groupchats{{/str}}{{/ok}}</span></span>
                </div>
                <div class="small text-muted">{{help}}{{#code}} <code>{{code}}</code>{{/code}}</div>
            </div>
        </li>
        {{/checks}}
    </ul>
    {{#allok}}<p class="text-success fw-bold">{{#str}}allok, local_groupchats{{/str}}</p>{{/allok}}
    <form method="post" action="{{actionurl}}" class="d-inline">
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="allowall">
        <button type="submit" class="btn btn-primary btn-lg local-groupchats-fab">{{#str}}allowall, local_groupchats{{/str}}</button>
    </form>
    <a class="btn btn-link" href="{{permissionsurl}}">{{#str}}reviewrole, local_groupchats{{/str}}</a>
    <p class="small text-muted mt-3">{{#str}}allowall_desc, local_groupchats{{/str}}</p>
</div>
