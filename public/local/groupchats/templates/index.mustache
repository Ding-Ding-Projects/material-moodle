{{!
    @template local_groupchats/index

    List of group chats with a search box.

    Example context (json):
    {
        "chats": [{"id": 4, "name": "Project team", "initial": "P", "membercount": 3, "creator": "Alex Student",
            "last": "20/11/26, 21:00", "openurl": "#", "manageurl": "#", "ismember": true, "index": 0}],
        "haschats": true, "cancreate": true, "newurl": "#", "showtabs": false, "tabs": [], "messagingoff": false
    }
}}
<div class="local-groupchats local-groupchats-index">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <p class="text-muted mb-0">{{#str}}index_intro, local_groupchats{{/str}}</p>
        {{#cancreate}}<a class="btn btn-primary local-groupchats-fab" href="{{newurl}}">{{#pix}}t/add, core{{/pix}} {{#str}}newgroupchat, local_groupchats{{/str}}</a>{{/cancreate}}
    </div>
    {{#messagingoff}}<div class="alert alert-warning">{{#str}}errormessagingoff, local_groupchats{{/str}}</div>{{/messagingoff}}
    {{#showtabs}}
    <ul class="nav nav-tabs mb-3">
        {{#tabs}}<li class="nav-item"><a class="nav-link{{#active}} active{{/active}}" href="{{url}}" {{#active}}aria-current="page"{{/active}}>{{label}}</a></li>{{/tabs}}
    </ul>
    {{/showtabs}}
    <div class="mb-3">
        <label class="visually-hidden" for="local-groupchats-search">{{#str}}searchchats, local_groupchats{{/str}}</label>
        <input type="search" id="local-groupchats-search" class="form-control" placeholder="{{#str}}searchchats, local_groupchats{{/str}}"
            data-local-groupchats-search="#local-groupchats-list" autocomplete="off">
        <p class="small text-muted mt-1 mb-0" data-region="search-status" aria-live="polite"></p>
    </div>
    {{#haschats}}
    <ul class="list-group local-groupchats-list" id="local-groupchats-list">
        {{#chats}}
        <li class="list-group-item local-groupchats-item" style="--i: {{index}}" data-search-item>
            <div class="d-flex gap-3 align-items-center">
                <span class="local-groupchats-avatar" aria-hidden="true">{{initial}}</span>
                <div class="flex-grow-1 min-width-0">
                    <h3 class="h6 mb-1 text-truncate">{{name}}</h3>
                    <div class="small text-muted">{{#str}}membercount, local_groupchats, {{membercount}}{{/str}}{{#creator}} · {{#str}}startedby, local_groupchats, {{creator}}{{/str}}{{/creator}} · {{last}}</div>
                </div>
                <div class="d-flex gap-2 flex-wrap justify-content-end">
                    {{#ismember}}<a class="btn btn-sm btn-primary" href="{{openurl}}">{{#str}}openchat, local_groupchats{{/str}}</a>{{/ismember}}
                    <a class="btn btn-sm btn-outline-secondary" href="{{manageurl}}">{{#str}}manage, local_groupchats{{/str}}</a>
                </div>
            </div>
        </li>
        {{/chats}}
    </ul>
    <p class="text-muted mt-3" hidden data-region="no-match">{{#str}}nomatches, local_groupchats{{/str}}</p>
    {{/haschats}}
    {{^haschats}}
    <div class="local-groupchats-empty text-center p-5">
        <div class="local-groupchats-empty-icon" aria-hidden="true">{{#pix}}t/message, core{{/pix}}</div>
        <p class="lead mb-3">{{#str}}nochats, local_groupchats{{/str}}</p>
        {{#cancreate}}<a class="btn btn-outline-primary" href="{{newurl}}">{{#str}}newgroupchat, local_groupchats{{/str}}</a>{{/cancreate}}
    </div>
    {{/haschats}}
</div>
{{#js}}
require(['local_groupchats/ui'], function(Ui) {
    Ui.init();
});
{{/js}}
