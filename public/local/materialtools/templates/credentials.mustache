{{!
    @template local_materialtools/credentials

    The new student's credentials, ready to paste into Discord.

    Example context (json):
    {
        "fullname": "Alex Student",
        "username": "alex.student",
        "password": "Maple-Otter-7342!",
        "message": "**Site** sign-in",
        "profileurl": "#",
        "againurl": "#",
        "vocabulary": false
    }
}}
<div class="local-materialtools-credentials" data-md-celebrate="success">
    <div class="alert alert-success" data-md-celebrated="1" role="status">{{#str}}studentcreated, local_materialtools, {{fullname}}{{/str}}</div>
    <div class="card mb-4">
        <div class="card-body d-flex flex-column gap-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h2 class="h4 mb-0">{{#str}}readyfordiscord, local_materialtools{{/str}}</h2>
                <button type="button" class="btn btn-primary" data-md-copy="local-materialtools-message" data-md-copied-label="{{#str}}copiedfordiscord, local_materialtools{{/str}}">{{#str}}copyfordiscord, local_materialtools{{/str}}</button>
            </div>
            <p class="text-muted mb-0">{{#str}}shownonce, local_materialtools{{/str}}</p>
            <label class="visually-hidden" for="local-materialtools-message">{{#str}}readyfordiscord, local_materialtools{{/str}}</label>
            <textarea id="local-materialtools-message" class="form-control font-monospace" rows="11" readonly>{{message}}</textarea>
            <div>
                <span class="small fw-bold text-muted">{{#str}}username{{/str}}</span>
                <div class="d-flex gap-2 align-items-center mt-1">
                    <code id="local-materialtools-username" class="flex-grow-1 p-2 rounded bg-body-tertiary fs-6">{{username}}</code>
                    <button type="button" class="btn btn-secondary" data-md-copy="local-materialtools-username">{{#str}}copy, local_materialtools{{/str}}</button>
                </div>
            </div>
            <div>
                <span class="small fw-bold text-muted">{{#str}}temporarypassword, local_materialtools{{/str}}</span>
                <div class="d-flex gap-2 align-items-center mt-1">
                    <code id="local-materialtools-password" class="flex-grow-1 p-2 rounded bg-body-tertiary fs-6">{{password}}</code>
                    <button type="button" class="btn btn-secondary" data-md-copy="local-materialtools-password">{{#str}}copy, local_materialtools{{/str}}</button>
                </div>
            </div>
            <ul class="mb-0 small">
                <li>{{#str}}willchangepassword, local_materialtools{{/str}}</li>
                <li>{{#str}}willofferpasskey, local_materialtools{{/str}}</li>
                {{#vocabulary}}<li>{{#str}}willgetvocab, local_materialtools{{/str}}</li>{{/vocabulary}}
            </ul>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="{{againurl}}">{{#str}}addanother, local_materialtools{{/str}}</a>
        <a class="btn btn-outline-secondary" href="{{profileurl}}">{{#str}}viewprofile, local_materialtools{{/str}}</a>
    </div>
</div>
{{#js}}
require(['local_materialtools/copy'], function(Copy) {
    Copy.init();
});
{{/js}}
