{{!
    @template local_materialtools/mypack

    Your own wording pack.

    Example context (json):
    {"present": true, "count": 12, "updated": "21 November 2026", "sitepack": true, "actionurl": "#", "sesskey": "x"}
}}
<div class="local-materialtools-mypack d-flex flex-column gap-4" style="max-width: 52rem;">
    <p class="lead mb-0">{{#str}}personalvocab_desc, local_materialtools{{/str}}</p>
    {{#sitepack}}<div class="alert alert-info mb-0">{{#str}}personalvocabsite, local_materialtools{{/str}}</div>{{/sitepack}}
    <div class="card">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            {{#present}}
                <div class="flex-grow-1">
                    <h2 class="h5 mb-1">{{#str}}personalvocabactive, local_materialtools, {{count}}{{/str}}</h2>
                    <p class="text-muted small mb-0">{{#str}}personalvocabupdated, local_materialtools, {{updated}}{{/str}}</p>
                </div>
                <form method="post" action="{{actionurl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="clear">
                    <button type="submit" class="btn btn-outline-danger">{{#str}}personalvocabclear, local_materialtools{{/str}}</button>
                </form>
            {{/present}}
            {{^present}}
                <div class="flex-grow-1">
                    <h2 class="h5 mb-1">{{#str}}personalvocabnone, local_materialtools{{/str}}</h2>
                    <p class="text-muted small mb-0">{{#str}}personalvocabdrop, local_materialtools{{/str}}</p>
                </div>
            {{/present}}
        </div>
    </div>
    <form method="post" action="{{actionurl}}" enctype="multipart/form-data" class="card" data-region="vocab-drop">
        <div class="card-body d-flex flex-column gap-3">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="upload">
            <label class="form-label mb-0" for="mypack-file">{{#str}}vocabfile, local_materialtools{{/str}}</label>
            <input type="file" class="form-control" id="mypack-file" name="vocabfile" accept=".json,application/json">
            <label class="form-label mb-0" for="mypack-text">{{#str}}vocabtext, local_materialtools{{/str}}</label>
            <textarea class="form-control font-monospace" id="mypack-text" name="vocabtext" rows="8" spellcheck="false"></textarea>
            <div><button type="submit" class="btn btn-primary">{{#str}}personalvocabsave, local_materialtools{{/str}}</button></div>
        </div>
    </form>
</div>
