{{!
    @template local_materialtools/onboarding

    First-run setup wizard.

    Example context (json):
    {
        "actionurl": "#", "step": "colour", "iscolour": true, "sesskey": "x", "percent": 0, "first": true,
        "optional": false, "progress": [{"label": "Colour", "done": true, "current": true, "url": "#"}],
        "seedcolor": "#8B5000", "swatches": [{"hex": "#8B5000"}], "motions": []
    }
}}
<div class="local-materialtools-onboarding md-stagger">
    <nav aria-label="{{#str}}onboard_steps, local_materialtools{{/str}}" class="mb-4">
        <div class="progress mb-3" role="progressbar" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: {{percent}}%"></div>
        </div>
        <ol class="list-unstyled d-flex flex-wrap gap-2 mb-0">
            {{#progress}}
            <li><a class="btn btn-sm {{#current}}btn-primary{{/current}}{{^current}}{{#done}}btn-secondary{{/done}}{{^done}}btn-outline-secondary{{/done}}{{/current}}" href="{{url}}" {{#current}}aria-current="step"{{/current}}>{{label}}</a></li>
            {{/progress}}
        </ol>
    </nav>
    <form method="post" action="{{actionurl}}" class="card">
        <div class="card-body d-flex flex-column gap-3 p-4">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="step" value="{{step}}">
            {{#iscolour}}
                <h2>{{#str}}onboard_colour_title, local_materialtools{{/str}}</h2>
                <p class="text-muted">{{#str}}onboard_colour_desc, local_materialtools{{/str}}</p>
                <div class="d-flex flex-wrap gap-2 align-items-center" role="radiogroup" aria-label="{{#str}}seedcolor, theme_material{{/str}}">
                    {{#swatches}}
                    <label class="local-materialtools-swatch" style="background: {{hex}}">
                        <input type="radio" name="seedswatch" value="{{hex}}" class="visually-hidden" data-swatch="{{hex}}"><span class="visually-hidden">{{hex}}</span>
                    </label>
                    {{/swatches}}
                    <label class="d-flex align-items-center gap-2 ms-2">{{#str}}onboard_custom, local_materialtools{{/str}}
                        <input type="color" name="seedcolor" value="{{seedcolor}}" class="form-control form-control-color">
                    </label>
                </div>
                <fieldset class="d-flex flex-wrap gap-3">
                    <legend class="h6">{{#str}}motion, theme_material{{/str}}</legend>
                    {{#motions}}
                    <div class="form-check"><input class="form-check-input" type="radio" name="motion" id="ob-motion-{{value}}" value="{{value}}" {{#checked}}checked{{/checked}}><label class="form-check-label" for="ob-motion-{{value}}">{{label}}</label></div>
                    {{/motions}}
                </fieldset>
            {{/iscolour}}
            {{#issignin}}
                <h2>{{#str}}onboard_signin_title, local_materialtools{{/str}}</h2>
                <label class="form-label" for="ob-heading">{{#str}}loginheading, theme_material{{/str}}</label>
                <input class="form-control" id="ob-heading" name="loginheading" value="{{loginheading}}">
                <label class="form-label" for="ob-text">{{#str}}logintext, theme_material{{/str}}</label>
                <textarea class="form-control" id="ob-text" name="logintext" rows="3">{{logintext}}</textarea>
            {{/issignin}}
            {{#ispasskeys}}
                <h2>{{#str}}onboard_passkeys_title, local_materialtools{{/str}}</h2>
                <p class="text-muted">{{#str}}onboard_passkeys_desc, local_materialtools{{/str}}</p>
                <div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" id="ob-passkeys" name="passkeys" value="1" {{#passkeyson}}checked{{/passkeyson}}><label class="form-check-label" for="ob-passkeys">{{#str}}onboard_passkeys_on, local_materialtools{{/str}}</label></div>
                <div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" id="ob-offer" name="offer" value="1" {{#offeron}}checked{{/offeron}}><label class="form-check-label" for="ob-offer">{{#str}}offeronfirstlogin, auth_passkey{{/str}}</label></div>
            {{/ispasskeys}}
            {{#isvocabulary}}
                <h2>{{#str}}vocabulary, local_materialtools{{/str}}</h2>
                <p class="text-muted">{{#str}}vocab_desc, local_materialtools{{/str}}</p>
                <p>{{#vocabpresent}}{{#str}}onboard_vocab_loaded, local_materialtools{{/str}}{{/vocabpresent}}{{^vocabpresent}}{{#str}}vocabstatusnone, local_materialtools{{/str}}{{/vocabpresent}}</p>
                <a class="btn btn-secondary align-self-start" href="{{vocabularyurl}}" target="_blank" rel="noopener">{{#str}}onboard_vocab_open, local_materialtools{{/str}}</a>
            {{/isvocabulary}}
            {{#iswording}}
                <h2>{{#str}}wording, local_materialtools{{/str}}</h2>
                <p class="text-muted">{{#str}}wording_desc, local_materialtools{{/str}}</p>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label" for="ob-teacher">{{#str}}wordingrole_editingteacher, local_materialtools{{/str}}</label><input class="form-control" id="ob-teacher" name="teacher" value="{{teacher}}" placeholder="{{#str}}wordingdefault, local_materialtools{{/str}}"></div>
                    <div class="col-md-6"><label class="form-label" for="ob-student">{{#str}}wordingrole_student, local_materialtools{{/str}}</label><input class="form-control" id="ob-student" name="student" value="{{student}}" placeholder="{{#str}}wordingdefault, local_materialtools{{/str}}"></div>
                    <div class="col-md-6"><label class="form-label" for="ob-as">{{#str}}wordingassignsingular, local_materialtools{{/str}}</label><input class="form-control" id="ob-as" name="assignsingular" value="{{assignsingular}}" placeholder="{{#str}}wordingdefault, local_materialtools{{/str}}"></div>
                    <div class="col-md-6"><label class="form-label" for="ob-ap">{{#str}}wordingassignplural, local_materialtools{{/str}}</label><input class="form-control" id="ob-ap" name="assignplural" value="{{assignplural}}" placeholder="{{#str}}wordingdefault, local_materialtools{{/str}}"></div>
                </div>
            {{/iswording}}
            {{#isdone}}
                <div data-md-celebrate="success" class="text-center py-4">
                    <h2 class="display-5">{{#str}}onboard_done_title, local_materialtools{{/str}}</h2>
                    <p class="lead">{{#str}}onboard_done_desc, local_materialtools{{/str}}</p>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <a class="btn btn-primary btn-lg" href="{{newstudenturl}}">{{#str}}newstudent, local_materialtools{{/str}}</a>
                        <a class="btn btn-outline-secondary btn-lg" href="{{dashboardurl}}">{{#str}}onboard_dashboard, local_materialtools{{/str}}</a>
                    </div>
                </div>
            {{/isdone}}
            {{^isdone}}
            <div class="d-flex flex-wrap gap-2 justify-content-between mt-2">
                <button type="submit" name="go" value="back" class="btn btn-outline-secondary" {{#first}}disabled{{/first}}>{{#str}}back{{/str}}</button>
                <div class="d-flex gap-2">
                    {{#optional}}<button type="submit" name="go" value="skip" class="btn btn-link">{{#str}}onboard_skip, local_materialtools{{/str}}</button>{{/optional}}
                    <button type="submit" name="go" value="next" class="btn btn-primary btn-lg">{{#str}}next{{/str}}</button>
                </div>
            </div>
            {{/isdone}}
        </div>
    </form>
</div>
{{#js}}
document.querySelectorAll('[data-swatch]').forEach(function(radio) {
    radio.addEventListener('change', function() {
        var picker = document.querySelector('input[type=color][name=seedcolor]');
        if (picker) {
            picker.value = radio.getAttribute('data-swatch').toLowerCase();
        }
    });
});
{{/js}}
