{{!
    @template local_meetups/poll

    Scheduling poll with live tally.

    Example context (json):
    {
        "id": 1, "title": "Study group", "isopen": true, "canmanage": true, "hasoptions": true, "voters": 2,
        "options": [{"id": 3, "date": "Friday, 4 December 2026", "time": "5:00 PM – 6:00 PM", "yes": 2, "ifneeded": 0,
            "no": 0, "score": 4, "best": true, "percent": 100, "isfinal": false,
            "buttons": [{"value": 2, "key": "yes", "label": "Yes", "optionid": 3, "checked": true}]}],
        "matrix": [], "hasmatrix": false, "sesskey": "x", "actionurl": "#", "viewurl": "#", "editurl": "#",
        "isscheduled": false, "when": "Date to be decided", "saved": false
    }
}}
<div class="local-meetups local-meetups-poll" data-meetupid="{{id}}">
    {{#saved}}<div class="alert alert-success local-meetups-pop" role="status" data-md-celebrate="success">{{#str}}votessaved, local_meetups{{/str}}</div>{{/saved}}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h3 mb-1">{{#str}}poll, local_meetups{{/str}}</h2>
            <p class="text-muted mb-0">{{#isopen}}{{#str}}poll_intro, local_meetups{{/str}}{{/isopen}}{{#isscheduled}}{{#str}}poll_scheduled, local_meetups, {{when}}{{/str}}{{/isscheduled}}</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{viewurl}}">{{#str}}backtomeetup, local_meetups{{/str}}</a>
            {{#canmanage}}{{#isopen}}<a class="btn btn-outline-secondary" href="{{editurl}}">{{#str}}editoptions, local_meetups{{/str}}</a>{{/isopen}}{{/canmanage}}
        </div>
    </div>

    <p class="small text-muted" aria-live="polite"><span data-region="voters">{{voters}}</span> {{#str}}peoplevoted, local_meetups{{/str}}
        <span class="local-meetups-live" data-region="live" hidden>· {{#str}}livetally, local_meetups{{/str}}</span></p>

    <div class="mb-3 local-meetups-searchbar">
        <label class="visually-hidden" for="local-meetups-option-search">{{#str}}searchoptions, local_meetups{{/str}}</label>
        <input type="search" id="local-meetups-option-search" class="form-control" placeholder="{{#str}}searchoptions, local_meetups{{/str}}"
            data-local-meetups-search="#local-meetups-options" autocomplete="off">
    </div>

    {{#hasoptions}}
    <form method="post" action="{{actionurl}}" data-region="poll-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="vote">
        <div class="list-group mb-3" id="local-meetups-options">
            {{#options}}
            <div class="list-group-item local-meetups-option{{#best}} is-best{{/best}}{{#isfinal}} is-final{{/isfinal}}" data-optionid="{{id}}" data-search-item>
                <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
                    <div class="local-meetups-option-when">
                        <div class="fw-bold">{{time}}</div>
                        <span class="local-meetups-chip is-best-chip" data-region="best">{{#str}}bestoption, local_meetups{{/str}}</span>
                        {{#isfinal}}<span class="local-meetups-chip is-scheduled">{{#str}}finaltime, local_meetups{{/str}}</span>{{/isfinal}}
                    </div>
                    {{#isopen}}
                    <fieldset class="local-meetups-segmented d-flex gap-1" data-region="vote">
                        <legend class="visually-hidden">{{#str}}youranswerfor, local_meetups, {{time}}{{/str}}</legend>
                        {{#buttons}}
                        <input type="radio" class="btn-check" name="vote[{{optionid}}]" id="local-meetups-v-{{optionid}}-{{value}}" value="{{value}}" {{#checked}}checked{{/checked}}>
                        <label class="btn btn-sm btn-outline-primary is-{{key}}" for="local-meetups-v-{{optionid}}-{{value}}">{{label}}</label>
                        {{/buttons}}
                    </fieldset>
                    {{/isopen}}
                </div>
                <div class="d-flex flex-wrap gap-3 align-items-center mt-2 small">
                    <span class="local-meetups-count is-yes">{{#str}}vote_yes, local_meetups{{/str}}: <strong data-count="yes">{{yes}}</strong></span>
                    <span class="local-meetups-count is-ifneeded">{{#str}}vote_ifneeded, local_meetups{{/str}}: <strong data-count="ifneeded">{{ifneeded}}</strong></span>
                    <span class="local-meetups-count is-no">{{#str}}vote_no, local_meetups{{/str}}: <strong data-count="no">{{no}}</strong></span>
                    <div class="progress flex-grow-1 local-meetups-bar" role="progressbar" aria-label="{{#str}}score, local_meetups{{/str}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{percent}}">
                        <div class="progress-bar" data-region="bar" style="width: {{percent}}%"></div>
                    </div>
                    {{#canmanage}}
                    <button type="submit" class="btn btn-sm btn-primary" form="local-meetups-finalise-{{id}}">{{#str}}pickthistime, local_meetups{{/str}}</button>
                    {{/canmanage}}
                </div>
            </div>
            {{/options}}
        </div>
        {{#isopen}}<noscript><button type="submit" class="btn btn-primary">{{#str}}savevotes, local_meetups{{/str}}</button></noscript>{{/isopen}}
    </form>
    {{#canmanage}}
    {{#options}}
    <form method="post" action="{{actionurl}}" id="local-meetups-finalise-{{id}}" hidden>
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="finalise">
        <input type="hidden" name="optionid" value="{{id}}">
    </form>
    {{/options}}
    {{/canmanage}}
    {{/hasoptions}}
    {{^hasoptions}}<p class="text-muted">{{#str}}nooptions, local_meetups{{/str}}</p>{{/hasoptions}}

    {{#hasmatrix}}
    <details class="card mt-4 local-meetups-matrix">
        <summary class="card-body fw-bold">{{#str}}whovotedwhat, local_meetups{{/str}}</summary>
        <div class="table-responsive px-3 pb-3">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th scope="col">{{#str}}name{{/str}}</th>{{#options}}<th scope="col" class="small">{{time}}</th>{{/options}}</tr></thead>
                <tbody>
                    {{#matrix}}
                    <tr><th scope="row">{{fullname}}</th>{{#cells}}<td><span class="local-meetups-chip is-{{key}}">{{label}}</span></td>{{/cells}}</tr>
                    {{/matrix}}
                </tbody>
            </table>
        </div>
    </details>
    {{/hasmatrix}}
</div>
{{#js}}
require(['local_meetups/ui', 'local_meetups/poll'], function(Ui, Poll) {
    Ui.init();
    Poll.init({{id}}, {{#isopen}}true{{/isopen}}{{^isopen}}false{{/isopen}});
});
{{/js}}
