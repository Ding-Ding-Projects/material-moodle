{{!
    @template local_meetups/view

    One meetup with its details, reply form, attendee list and comments.

    Example context (json):
    {
        "id": 1, "title": "Study group", "typelabel": "Hybrid", "type": "hybrid", "status": "scheduled",
        "statuslabel": "Scheduled", "when": "Friday, 4 December 2026, 5:00 PM – 6:00 PM", "where": "Library",
        "organiser": "Alex Student", "audience": "Invited people", "going": 2, "capacity": 0,
        "description": "<p>Bring notes.</p>", "hasdescription": true, "location": "Library", "onlineurl": "https://example.com",
        "invitelink": "https://example.com/local/meetups/view.php?id=1", "isinviteonly": true, "sesskey": "x",
        "actionurl": "#", "canmanage": true, "isscheduled": true, "editurl": "#", "pollurl": "#", "exporturl": "#",
        "canrsvp": true, "responses": [{"value": "going", "label": "Going", "checked": true}], "mynote": "",
        "attendeegroups": [{"key": "going", "label": "Going", "count": 1, "haspeople": true,
            "people": [{"fullname": "Alex Student", "note": "", "profileurl": "#", "picture": ""}]}],
        "comments": [], "hascomments": false, "done": "", "confirmcancel": "Cancel?", "confirmdelete": "Delete?"
    }
}}
<div class="local-meetups local-meetups-view" data-meetupid="{{id}}">
    {{#done}}
    <div class="alert {{#donecelebrate}}alert-success{{/donecelebrate}}{{^donecelebrate}}alert-info{{/donecelebrate}} local-meetups-pop" role="status" {{#donecelebrate}}data-md-celebrate="success"{{/donecelebrate}}>{{done}}</div>
    {{/done}}

    <section class="card local-meetups-hero mb-4 is-{{status}}">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-2">
                <span class="local-meetups-chip is-{{status}}">{{statuslabel}}</span>
                <span class="local-meetups-chip is-type">{{typelabel}}</span>
                <span class="local-meetups-chip is-audience">{{audience}}</span>
            </div>
            <h2 class="h3 mb-3">{{title}}</h2>
            <dl class="local-meetups-facts mb-0">
                <dt>{{#pix}}i/calendar, core{{/pix}} <span class="visually-hidden">{{#str}}when, local_meetups{{/str}}</span></dt>
                <dd><strong>{{when}}</strong>{{#isplanning}} · <a href="{{pollurl}}">{{#str}}votenow, local_meetups{{/str}}</a>{{/isplanning}}</dd>
                {{#location}}
                <dt>{{#pix}}i/location, core{{/pix}} <span class="visually-hidden">{{#str}}location, local_meetups{{/str}}</span></dt>
                <dd>{{location}}</dd>
                {{/location}}
                {{#onlineurl}}
                <dt>{{#pix}}i/link, core{{/pix}} <span class="visually-hidden">{{#str}}onlineurl, local_meetups{{/str}}</span></dt>
                <dd class="d-flex flex-wrap align-items-center gap-2">
                    <a href="{{onlineurl}}" id="local-meetups-onlineurl" target="_blank" rel="noopener noreferrer" class="text-break">{{onlineurl}}</a>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-md-copy="local-meetups-onlineurl"
                        data-md-copied-label="{{#str}}copied, local_meetups{{/str}}">{{#str}}copylink, local_meetups{{/str}}</button>
                </dd>
                {{/onlineurl}}
                <dt>{{#pix}}i/user, core{{/pix}} <span class="visually-hidden">{{#str}}organiser, local_meetups{{/str}}</span></dt>
                <dd>{{#str}}organisedby, local_meetups, {{organiser}}{{/str}}</dd>
                {{#capacity}}
                <dt>{{#pix}}i/users, core{{/pix}} <span class="visually-hidden">{{#str}}capacity, local_meetups{{/str}}</span></dt>
                <dd>{{#str}}placestaken, local_meetups, {"going": {{going}}, "capacity": {{capacity}}}{{/str}}</dd>
                {{/capacity}}
                {{#deadline}}
                <dt>{{#pix}}i/duration, core{{/pix}} <span class="visually-hidden">{{#str}}rsvpdeadline, local_meetups{{/str}}</span></dt>
                <dd>{{#str}}repliesclose, local_meetups, {{deadline}}{{/str}}</dd>
                {{/deadline}}
            </dl>
            {{#hasdescription}}<div class="local-meetups-description mt-3">{{{description}}}</div>{{/hasdescription}}

            <div class="d-flex flex-wrap gap-2 mt-4">
                {{#isplanning}}<a class="btn btn-primary" href="{{pollurl}}">{{#str}}openpoll, local_meetups{{/str}}</a>{{/isplanning}}
                {{#isscheduled}}<a class="btn btn-outline-primary" href="{{exporturl}}">{{#pix}}i/export, core{{/pix}} {{#str}}exportics, local_meetups{{/str}}</a>{{/isscheduled}}
                {{#canmanage}}
                <a class="btn btn-outline-secondary" href="{{editurl}}">{{#str}}edit{{/str}}</a>
                {{#isscheduled}}<a class="btn btn-outline-secondary" href="{{pollurl}}">{{#str}}changetime, local_meetups{{/str}}</a>{{/isscheduled}}
                {{^iscancelled}}
                <form method="post" action="{{actionurl}}" class="d-inline" data-local-meetups-confirm="{{confirmcancel}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="cancel">
                    <button type="submit" class="btn btn-outline-danger">{{#str}}cancelmeetup, local_meetups{{/str}}</button>
                </form>
                {{/iscancelled}}
                <form method="post" action="{{actionurl}}" class="d-inline" data-local-meetups-confirm="{{confirmdelete}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="delete">
                    <button type="submit" class="btn btn-danger">{{#str}}delete{{/str}}</button>
                </form>
                {{/canmanage}}
            </div>
        </div>
    </section>

    <section class="card mb-4 local-meetups-invite">
        <div class="card-body">
            <h3 class="h5">{{#str}}invitelink, local_meetups{{/str}}</h3>
            <p class="text-muted small mb-2">{{#isinviteonly}}{{#str}}invitelink_desc, local_meetups{{/str}}{{/isinviteonly}}{{^isinviteonly}}{{#str}}invitelink_scoped, local_meetups{{/str}}{{/isinviteonly}}</p>
            <div class="d-flex gap-2 align-items-center">
                <code class="flex-grow-1 p-2 rounded bg-body-tertiary text-break local-meetups-code" id="local-meetups-invitelink">{{invitelink}}</code>
                <button type="button" class="btn btn-primary text-nowrap" data-md-copy="local-meetups-invitelink"
                    data-md-copied-label="{{#str}}copied, local_meetups{{/str}}">{{#str}}copyinvitelink, local_meetups{{/str}}</button>
            </div>
        </div>
    </section>

    {{#isscheduled}}
    <section class="card mb-4 local-meetups-rsvp" id="local-meetups-rsvp">
        <div class="card-body">
            <h3 class="h5">{{#str}}yourreply, local_meetups{{/str}}</h3>
            {{#iswaitlisted}}<div class="alert alert-info local-meetups-pop" role="status">{{#str}}youarewaitlisted, local_meetups{{/str}}</div>{{/iswaitlisted}}
            {{#canrsvp}}
            {{#isfull}}<p class="small text-muted">{{#str}}fullwaitlist, local_meetups{{/str}}</p>{{/isfull}}
            <form method="post" action="{{actionurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="rsvp">
                <fieldset>
                    <legend class="visually-hidden">{{#str}}yourreply, local_meetups{{/str}}</legend>
                    <div class="d-flex flex-wrap gap-2 mb-3 local-meetups-segmented" role="radiogroup">
                        {{#responses}}
                        <input type="radio" class="btn-check" name="response" id="local-meetups-r-{{value}}" value="{{value}}" {{#checked}}checked{{/checked}} required>
                        <label class="btn btn-outline-primary is-{{value}}" for="local-meetups-r-{{value}}">{{label}}</label>
                        {{/responses}}
                    </div>
                </fieldset>
                <label class="form-label" for="local-meetups-note">{{#str}}note, local_meetups{{/str}}</label>
                <input type="text" class="form-control mb-3" name="note" id="local-meetups-note" maxlength="255" value="{{mynote}}"
                    placeholder="{{#str}}note_placeholder, local_meetups{{/str}}">
                <button type="submit" class="btn btn-primary">{{#str}}savereply, local_meetups{{/str}}</button>
            </form>
            {{/canrsvp}}
            {{#rsvpclosed}}<p class="text-muted mb-0">{{#str}}repliesclosed, local_meetups{{/str}}</p>{{/rsvpclosed}}
        </div>
    </section>
    {{/isscheduled}}

    <section class="card mb-4 local-meetups-attendees">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h3 class="h5 mb-0">{{#str}}attendees, local_meetups{{/str}}</h3>
                <div class="local-meetups-searchbar">
                    <label class="visually-hidden" for="local-meetups-people-search">{{#str}}searchpeople, local_meetups{{/str}}</label>
                    <input type="search" id="local-meetups-people-search" class="form-control form-control-sm"
                        placeholder="{{#str}}searchpeople, local_meetups{{/str}}" data-local-meetups-search="#local-meetups-people" autocomplete="off">
                </div>
            </div>
            <div class="row g-3" id="local-meetups-people">
                {{#attendeegroups}}
                <div class="col-12 col-md-6 col-xl-3">
                    <h4 class="h6 local-meetups-grouphead is-{{key}}">{{label}} <span class="badge rounded-pill bg-secondary">{{count}}</span></h4>
                    {{#haspeople}}
                    <ul class="list-group list-group-flush">
                        {{#people}}
                        <li class="list-group-item px-0 d-flex gap-2 align-items-center local-meetups-person" data-search-item>
                            {{{picture}}}
                            <div class="min-width-0">
                                <a href="{{profileurl}}">{{fullname}}</a>
                                {{#note}}<div class="small text-muted text-break">{{note}}</div>{{/note}}
                            </div>
                        </li>
                        {{/people}}
                    </ul>
                    {{/haspeople}}
                    {{^haspeople}}<p class="small text-muted">{{#str}}nobodyyet, local_meetups{{/str}}</p>{{/haspeople}}
                </div>
                {{/attendeegroups}}
            </div>
        </div>
    </section>

    <section class="card mb-4 local-meetups-comments" id="local-meetups-comments">
        <div class="card-body">
            <h3 class="h5">{{#str}}comments, local_meetups{{/str}}</h3>
            {{#hascomments}}
            <ol class="list-unstyled local-meetups-thread">
                {{#comments}}
                <li class="d-flex gap-2 mb-3 local-meetups-comment">
                    {{{picture}}}
                    <div class="flex-grow-1 local-meetups-bubble">
                        <div class="d-flex justify-content-between gap-2">
                            <strong>{{fullname}}</strong><span class="small text-muted">{{time}}</span>
                        </div>
                        <div class="text-break">{{{content}}}</div>
                        {{#candelete}}
                        <form method="post" action="{{actionurl}}" class="mt-1" data-local-meetups-confirm="{{#str}}confirmdeletecomment, local_meetups{{/str}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="deletecomment">
                            <input type="hidden" name="commentid" value="{{id}}">
                            <button type="submit" class="btn btn-link btn-sm p-0 text-danger">{{#str}}delete{{/str}}</button>
                        </form>
                        {{/candelete}}
                    </div>
                </li>
                {{/comments}}
            </ol>
            {{/hascomments}}
            {{^hascomments}}<p class="text-muted">{{#str}}nocomments, local_meetups{{/str}}</p>{{/hascomments}}
            <form method="post" action="{{actionurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="comment">
                <label class="visually-hidden" for="local-meetups-comment">{{#str}}addcomment, local_meetups{{/str}}</label>
                <textarea class="form-control mb-2" id="local-meetups-comment" name="content" rows="3" maxlength="4000" required
                    placeholder="{{#str}}addcomment, local_meetups{{/str}}"></textarea>
                <button type="submit" class="btn btn-primary">{{#str}}postcomment, local_meetups{{/str}}</button>
            </form>
        </div>
    </section>
</div>
{{#js}}
require(['local_meetups/ui'], function(Ui) {
    Ui.init();
});
{{/js}}
