{{!
    @template core/login_panel

    Material sign-in panel: palette shapes, the configured heading, text and labels.

    Example context (json):
    {
        "leftinstructions": "",
        "sitename": "Moodle",
        "materiallogin": {"heading": "Learning, in full colour.", "text": "Sign in.", "haschips": true, "chips": ["Passkeys"]}
    }
}}
<div class="material-login-panel">
    <span class="material-login-shapes" aria-hidden="true">
        <span class="material-shape material-shape-a"></span>
        <span class="material-shape material-shape-b"></span>
        <span class="material-shape material-shape-c"></span>
    </span>
    <div class="material-login-brand md-rise">
        <span class="material-login-mark" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>
        </span>
        <span class="material-login-sitename">{{sitename}}</span>
    </div>
    <div class="material-login-copy md-rise md-rise-2">
        {{^leftinstructions}}
            <h2 class="material-login-heading">{{materiallogin.heading}}</h2>
            <p class="material-login-text">{{materiallogin.text}}</p>
        {{/leftinstructions}}
        {{#leftinstructions}}
            <div class="material-login-instructions">{{{leftinstructions}}}</div>
        {{/leftinstructions}}
    </div>
    {{#materiallogin.haschips}}
    <ul class="material-login-chips md-rise md-rise-3">
        {{#materiallogin.chips}}<li>{{.}}</li>{{/materiallogin.chips}}
    </ul>
    {{/materiallogin.haschips}}
</div>
